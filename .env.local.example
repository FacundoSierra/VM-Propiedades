# Copia este archivo como .env.local para probar el panel /admin en tu
# propio ordenador. En Vercel estas mismas claves se configuran en
# Settings -> Environment Variables (no en un archivo).

# Contraseña para entrar en /admin. Elige la que quieras.
ADMIN_PASSWORD=

# Token de acceso personal de GitHub (fine-grained), con permiso de
# "Contents: Read and write" sobre el repo FacundoSierra/VM-Propiedades.
# GitHub -> Settings -> Developer settings -> Personal access tokens.
GITHUB_TOKEN=

# La añade Vercel automáticamente al activar "Blob" en Storage -> Create
# Database -> Blob. No hace falta escribirla a mano en Vercel.
BLOB_READ_WRITE_TOKEN=

# Ya configuradas de antes (formularios de contacto/valoración):
RESEND_API_KEY=
RESEND_FROM_EMAIL=
