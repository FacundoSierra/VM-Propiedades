# Copia este archivo como .env.local para probar la web y el panel en tu
# ordenador: la web en http://localhost:3000 y el panel en
# http://panel.localhost:3000 (como en producción) o en
# http://localhost:3000/admin (como en una vista previa). En Vercel, estas mismas
# variables se ponen en Settings -> Environment Variables (no en un archivo).
# Aquí no va nunca un valor real.
#
# Las que empiezan por NEXT_PUBLIC_ se meten en el código al compilar: si las
# cambias en Vercel, vuelve a desplegar para que se note.

# --- Supabase: los inmuebles y las cuentas del panel ----------------------------
# Production, Preview y Development llevan las mismas (la misma base).

# La "Project URL" del proyecto: Supabase -> Settings -> API.
# Tiene la forma https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# La clave PUBLICABLE (empieza por sb_publishable_): Supabase -> Settings ->
# API Keys. No es secreta: lo que deja ver y cambiar lo decide el RLS de la base.
# Nunca pongas aquí la secreta (sb_secret_) ni la service_role: se saltan el
# RLS. Si detecta una, la web da error en vez de usarla.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Mantener viva la base ------------------------------------------------------
# Vercel Cron llama a /api/salud una vez al día para que Supabase no pause el
# proyecto, y manda este secreto en la cabecera Authorization.
# En Vercel, solo en Production: 32 letras y números al azar, por ejemplo con
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# En local solo hace falta para probar /api/salud a mano con curl.
CRON_SECRET=

# --- Fotos (Vercel Blob) --------------------------------------------------------
# Las pone Vercel solas al conectar el almacén de Blob al proyecto (Storage).
# Es el sistema sin clave: BLOB_STORE_ID y las credenciales OIDC que Vercel da a
# cada función. No hace falta BLOB_READ_WRITE_TOKEN.
# El almacén tiene que ser PÚBLICO (Access: Public): uno privado rechaza las subidas.
# En local, para subir o borrar fotos de verdad: `npx vercel env pull .env.local`,
# que trae también VERCEL_OIDC_TOKEN (dura unas horas). Sin ellas, el panel
# funciona igual, pero no sube fotos.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=

# --- Formularios de contacto y valoración (Resend) -------------------------------
# Sin cambios. La clave de los formularios no es la del SMTP de Supabase: esa
# va en los ajustes de Auth de Supabase, no aquí.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Panel antiguo: ya no se usan -----------------------------------------------
# ADMIN_PASSWORD y GITHUB_TOKEN eran del panel de antes (contraseña única y
# commits en GitHub). El código de REQ-001 ya no los lee: no los pongas aquí.
# En Vercel se borran el día después de comprobar el panel nuevo en producción
# (REQ-001, sección 12, paso 8), y el token se revoca en GitHub. Hasta entonces
# se quedan allí, para poder volver a la versión anterior (Instant Rollback).
